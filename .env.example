# Database
DATABASE_URL=postgresql+psycopg://constructai:constructai_dev@localhost:5432/constructai

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Weather API (optional for MVP)
WEATHER_API_KEY=

# Next.js public env (web app)
NEXT_PUBLIC_API_URL=http://localhost:8000
